    "publish:ipfs": "node scripts/publish-ipfs.mjs",
    "finalize:publication": "node scripts/finalize-publication.mjs",
    "verify:publication": "node scripts/verify-publication.mjs"
  },
  "dependencies": {
    "@ekza/avatar-renderer": "git+https://github.com/ekza-space/ekza-avatar-renderer.git#88432da60940a259a2b3f4163199f983a5584499",
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "esbuild": "0.25.12",
    "ipfs-only-hash": "^4.0.0"
  }
}
