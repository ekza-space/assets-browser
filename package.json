{
  "name": "@ekza/assets-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "python3 server.py",
    "dev": "npm run build && python3 server.py",
